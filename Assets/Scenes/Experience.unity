  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2141546116}
  m_Text: "8 \xD7 EVGA GTX 1070 SC, 8 GB each\nASUS B250 mining board, PCIe risers\n2 \xD7 Antec HCP 1300 W Platinum\nUbuntu, CUDA, llama.cpp's llama-server\nQwen3.8 27B, GGUF Q4_K_M\nSplit across cards, over PCIe: no NVLink\nAbout 12 tokens/s today, aiming for 60+\nWarm start 2 s, cold start 2 min 27 s"
